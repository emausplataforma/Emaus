# Arquivo de EXEMPLO. Nada de valor real pode ser escrito aqui:
# este repositorio e PUBLICO, entao tudo o que for digitado aqui fica a vista
# de qualquer pessoa na internet. Preencha cada item somente como variavel
# privada no Railway (aba Variables).

# Railway preenche DATABASE_URL quando o servico for ligado ao PostgreSQL
DATABASE_URL=
PORT=8080
CORS_ORIGIN=https://emausplataforma.github.io
JWT_SECRET=gere-uma-chave-grande-e-aleatoria-com-pelo-menos-32-caracteres

# Contas criadas no primeiro arranque. Deixe em branco aqui e informe no Railway.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PASTOR_EMAIL=
PASTOR_PASSWORD=
RECEPTION_EMAIL=
RECEPTION_PASSWORD=

# URL publica usada nos links dos templates do bot
PUBLIC_APP_URL=https://emausplataforma.github.io/Emaus
# Integracoes comerciais - criar somente como variaveis privadas no Railway.
BILLING_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
SUPPORT_EMAIL=

# WhatsApp/Zapster - preencher somente apos confirmar a instancia e o contrato do provedor.
ZAPSTER_API_URL=
ZAPSTER_API_TOKEN=
ZAPSTER_WEBHOOK_SECRET=

# URL publica da propria API. Necessaria para o link compartilhado pela igreja
# mostrar o logo dela na previsualizacao do WhatsApp.
# Ex.: https://seu-servico.up.railway.app
PUBLIC_API_URL=

# Use apenas se o PostgreSQL exigir conexao criptografada (o Railway ja cuida disso sozinho).
# PGSSL=true
